# AI Document Assistant Configuration
# Copy these settings to your .env file and configure as needed

# ==============================================================================
# LLM API Configuration
# ==============================================================================

# Your LLM API key (REQUIRED for AI document generation)
# Get your API key from:
#   - OpenAI: https://platform.openai.com/api-keys
#   - Anthropic: https://console.anthropic.com/
LLM_API_KEY=

# LLM Provider to use (REQUIRED)
# Options: openai, anthropic, mock
# - openai: Use OpenAI's GPT models
# - anthropic: Use Anthropic's Claude models
# - mock: Use mock generator for testing (no API key needed)
LLM_PROVIDER=openai

# LLM Model to use (REQUIRED)
# OpenAI models:
#   - gpt-4-turbo-preview (recommended, most capable)
#   - gpt-4 (very capable, slower)
#   - gpt-3.5-turbo (faster, less expensive)
#
# Anthropic models:
#   - claude-3-opus-20240229 (most capable)
#   - claude-3-sonnet-20240229 (balanced)
#   - claude-3-haiku-20240307 (fastest)
LLM_MODEL=gpt-4-turbo-preview

# ==============================================================================
# Feature Configuration
# ==============================================================================

# Maximum number of rows to send to LLM
# Lower values = lower costs, but less data for AI to analyze
# Higher values = better insights, but higher costs and risk of token limits
# Recommended: 500-1000 for most queries
AI_DOCUMENT_MAX_ROWS=1000

# Enable/disable the AI Document Assistant feature
# Set to false to completely disable the feature
AI_DOCUMENT_ENABLED=true

# ==============================================================================
# Example Configurations
# ==============================================================================

# Example 1: OpenAI GPT-4
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo-preview
# AI_DOCUMENT_MAX_ROWS=1000
# AI_DOCUMENT_ENABLED=true

# Example 2: Anthropic Claude
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-opus-20240229
# AI_DOCUMENT_MAX_ROWS=1000
# AI_DOCUMENT_ENABLED=true

# Example 3: Testing with Mock (no API key needed)
# LLM_PROVIDER=mock
# LLM_MODEL=mock-model
# AI_DOCUMENT_MAX_ROWS=1000
# AI_DOCUMENT_ENABLED=true

# ==============================================================================
# Cost Considerations
# ==============================================================================
#
# OpenAI GPT-4 Turbo Pricing (as of 2024):
#   - Input: ~$10 per 1M tokens
#   - Output: ~$30 per 1M tokens
#   - Average query with 1000 rows ≈ 5-10K tokens ≈ $0.05-0.30 per generation
#
# Anthropic Claude 3 Opus Pricing (as of 2024):
#   - Input: ~$15 per 1M tokens
#   - Output: ~$75 per 1M tokens
#   - Average query with 1000 rows ≈ 5-10K tokens ≈ $0.08-0.80 per generation
#
# Tips to reduce costs:
#   1. Lower AI_DOCUMENT_MAX_ROWS (e.g., 500 or 250)
#   2. Use cheaper models (gpt-3.5-turbo or claude-3-haiku)
#   3. Monitor usage through your LLM provider dashboard
#   4. Set up usage alerts in your LLM provider account
#
# ==============================================================================
