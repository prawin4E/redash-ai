# AI Document Assistant Configuration
# Copy these settings to your .env file and configure as needed

# ==============================================================================
# LLM API Configuration
# ==============================================================================

# Your LLM API key (REQUIRED for OpenAI/Anthropic, not needed for Bedrock)
# Get your API key from:
#   - OpenAI: https://platform.openai.com/api-keys
#   - Anthropic: https://console.anthropic.com/
LLM_API_KEY=

# LLM Provider to use (REQUIRED)
# Options: openai, anthropic, bedrock, mock
# - openai: Use OpenAI's GPT models
# - anthropic: Use Anthropic's Claude models (direct API)
# - bedrock: Use AWS Bedrock Claude models
# - mock: Use mock generator for testing (no API key needed)
LLM_PROVIDER=openai

# LLM Model to use (REQUIRED)
# OpenAI models:
#   - gpt-4-turbo-preview (recommended, most capable)
#   - gpt-4 (very capable, slower)
#   - gpt-3.5-turbo (faster, less expensive)
#
# Anthropic models (direct API):
#   - claude-3-opus-20240229 (most capable)
#   - claude-3-sonnet-20240229 (balanced)
#   - claude-3-haiku-20240307 (fastest)
#
# AWS Bedrock models:
#   - anthropic.claude-3-5-sonnet-20241022-v2:0 (recommended - Claude 3.5 Sonnet v2)
#   - anthropic.claude-3-5-sonnet-20240620-v1:0 (Claude 3.5 Sonnet v1)
#   - anthropic.claude-3-sonnet-20240229-v1:0 (Claude 3 Sonnet)
#   - anthropic.claude-3-opus-20240229-v1:0 (Claude 3 Opus)
#   - anthropic.claude-3-haiku-20240307-v1:0 (Claude 3 Haiku - fastest)
#   - anthropic.claude-v2:1 (Claude 2.1)
#   - anthropic.claude-v2 (Claude 2)
LLM_MODEL=gpt-4-turbo-preview

# ==============================================================================
# AWS Bedrock Configuration (only when LLM_PROVIDER=bedrock)
# ==============================================================================

# AWS Region where Bedrock is available
# Common regions: us-east-1, us-west-2, eu-central-1, ap-southeast-1
AWS_BEDROCK_REGION=us-east-1

# AWS Access Key ID (for Bedrock authentication)
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key (for Bedrock authentication)
AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# Feature Configuration
# ==============================================================================

# Maximum number of rows to send to LLM
# Lower values = lower costs, but less data for AI to analyze
# Higher values = better insights, but higher costs and risk of token limits
# Recommended: 500-1000 for most queries
AI_DOCUMENT_MAX_ROWS=1000

# Enable/disable the AI Document Assistant feature
# Set to false to completely disable the feature
AI_DOCUMENT_ENABLED=true

# ==============================================================================
# Example Configurations
# ==============================================================================

# Example 1: OpenAI GPT-4
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo-preview
# AI_DOCUMENT_MAX_ROWS=1000
# AI_DOCUMENT_ENABLED=true

# Example 2: Anthropic Claude
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-opus-20240229
# AI_DOCUMENT_MAX_ROWS=1000
# AI_DOCUMENT_ENABLED=true

# Example 3: AWS Bedrock Claude 3.5 Sonnet
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AI_DOCUMENT_MAX_ROWS=1000
# AI_DOCUMENT_ENABLED=true

# Example 4: Testing with Mock (no API key needed)
# LLM_PROVIDER=mock
# LLM_MODEL=mock-model
# AI_DOCUMENT_MAX_ROWS=1000
# AI_DOCUMENT_ENABLED=true

# ==============================================================================
# Cost Considerations
# ==============================================================================
#
# OpenAI GPT-4 Turbo Pricing (as of 2024):
#   - Input: ~$10 per 1M tokens
#   - Output: ~$30 per 1M tokens
#   - Average query with 1000 rows ≈ 5-10K tokens ≈ $0.05-0.30 per generation
#
# Anthropic Claude 3 Opus Pricing (as of 2024):
#   - Input: ~$15 per 1M tokens
#   - Output: ~$75 per 1M tokens
#   - Average query with 1000 rows ≈ 5-10K tokens ≈ $0.08-0.80 per generation
#
# AWS Bedrock Claude 3.5 Sonnet Pricing (as of 2024):
#   - Input: ~$3 per 1M tokens
#   - Output: ~$15 per 1M tokens
#   - Average query with 1000 rows ≈ 5-10K tokens ≈ $0.02-0.15 per generation
#   - Note: Bedrock often has lower costs than direct API calls
#
# AWS Bedrock Claude 3 Haiku Pricing (as of 2024):
#   - Input: ~$0.25 per 1M tokens
#   - Output: ~$1.25 per 1M tokens
#   - Average query with 1000 rows ≈ 5-10K tokens ≈ $0.001-0.01 per generation
#   - Most cost-effective option!
#
# Tips to reduce costs:
#   1. Lower AI_DOCUMENT_MAX_ROWS (e.g., 500 or 250)
#   2. Use cheaper models (gpt-3.5-turbo or claude-3-haiku)
#   3. Monitor usage through your LLM provider dashboard
#   4. Set up usage alerts in your LLM provider account
#
# ==============================================================================
